<?xml version="1.0" encoding="utf-8"?>
<!--
    Família Manrope (títulos e números). Arquivos estáticos por peso, empacotados no APK.
    Fonte: Google Fonts, licença SIL Open Font License 1.1.
    Para o peso 800 use diretamente @font/manrope_extrabold (textStyle="bold" seleciona o 700).
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/manrope_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/manrope_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/manrope_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/manrope_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
