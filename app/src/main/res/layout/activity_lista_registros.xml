<?xml version="1.0" encoding="utf-8"?>
<!-- Listagem de registros com busca, filtro por categoria e botão flutuante -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ListaRegistrosActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Busca -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBusca"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_grande"
            android:layout_marginTop="@dimen/espaco_grande"
            android:layout_marginEnd="@dimen/espaco_grande"
            android:hint="@string/hint_busca"
            app:boxBackgroundColor="?attr/colorSurface"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Filtro por categoria -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:clipToPadding="false"
            android:paddingStart="@dimen/espaco_grande"
            android:paddingEnd="@dimen/espaco_grande"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltroTodos"
                    style="@style/Widget.App.Chip.Filtro"
                    android:checked="true"
                    android:text="@string/filtro_todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltroRegistros"
                    style="@style/Widget.App.Chip.Filtro"
                    android:text="@string/categoria_registro" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltroListas"
                    style="@style/Widget.App.Chip.Filtro"
                    android:text="@string/categoria_lista_controle" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltroAnotacoes"
                    style="@style/Widget.App.Chip.Filtro"
                    android:text="@string/categoria_anotacao" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvContador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/espaco_grande"
            android:paddingTop="@dimen/espaco_pequeno"
            android:paddingEnd="@dimen/espaco_grande"
            android:paddingBottom="@dimen/espaco_pequeno"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="5 registros" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRegistros"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                tools:listitem="@layout/item_registro" />

            <!-- Estado vazio -->
            <LinearLayout
                android:id="@+id/layoutVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/espaco_extra"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.5"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_inbox"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:text="@string/vazio_titulo"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/vazio_mensagem"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNovo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/espaco_grande"
        android:contentDescription="@string/acao_novo_registro"
        android:text="@string/acao_novo"
        app:backgroundTint="?attr/colorSecondary"
        app:icon="@drawable/ic_add"
        app:iconTint="?attr/colorOnSecondary"
        android:textColor="?attr/colorOnSecondary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
