<?xml version="1.0" encoding="utf-8"?>
<!-- Detalhes de um registro: cabeçalho, checklist (se houver), informações, descrição e ações -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza"
    tools:context=".DetalheRegistroActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/branco"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Producao.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/espessura_divisoria"
            android:background="@color/divisoria" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/altura_barra_acoes"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espaco_tela">

            <!-- ============ Cabeçalho do registro ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Producao.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_tela">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/tamanho_icone_item"
                            android:layout_height="@dimen/tamanho_icone_item"
                            android:background="@drawable/bg_quadrado_icone">

                            <ImageView
                                android:id="@+id/ivIconeCategoria"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                tools:src="@drawable/ic_registro" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvCategoria"
                            style="@style/Producao.Texto.Sobretitulo"
                            android:layout_marginStart="@dimen/espaco_medio"
                            tools:text="Registro" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTitulo"
                        style="@style/Producao.Texto"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/espaco_grande"
                        android:fontFamily="@font/manrope_extrabold"
                        android:textColor="@color/preto"
                        android:textIsSelectable="true"
                        android:textSize="24sp"
                        app:fontFamily="@font/manrope_extrabold"
                        tools:text="Parada para setup - Injetora 3" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_medio"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPrioridade"
                            style="@style/Producao.Pilula"
                            tools:background="@drawable/bg_pilula_alta"
                            tools:text="Alta" />

                        <TextView
                            android:id="@+id/tvStatus"
                            style="@style/Producao.Pilula"
                            android:layout_marginStart="@dimen/espaco_pequeno"
                            tools:background="@drawable/bg_pilula_pendente"
                            tools:text="Pendente" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Checklist (somente Lista de controle) ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChecklist"
                style="@style/Widget.Producao.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_tela">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Producao.Texto.Sobretitulo"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/rotulo_checklist" />

                        <TextView
                            android:id="@+id/tvChecklistProgresso"
                            style="@style/Producao.Texto"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/preto"
                            android:textSize="13sp"
                            app:fontFamily="@font/inter_semibold"
                            tools:text="2 de 4 respondidos" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressoChecklist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_medio"
                        android:max="100"
                        app:indicatorColor="@color/vermelho"
                        app:trackColor="@color/divisoria"
                        app:indicatorTrackGapSize="0dp"
                        app:trackCornerRadius="4dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="8dp"
                        tools:progress="50" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAbrirChecklist"
                        style="@style/Widget.Producao.Botao.Preto"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/espaco_grande"
                        android:text="@string/acao_abrir_checklist"
                        app:icon="@drawable/ic_checklist"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Informações ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Producao.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_tela">

                    <TextView
                        style="@style/Producao.Texto.Rotulo"
                        android:drawablePadding="6dp"
                        android:text="@string/rotulo_setor"
                        app:drawableStartCompat="@drawable/ic_location_pequeno"
                        app:drawableTint="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/tvSetor"
                        style="@style/Producao.Texto.Valor"
                        tools:text="Injeção" />

                    <TextView
                        style="@style/Producao.Texto.Rotulo"
                        android:layout_marginTop="@dimen/espaco_grande"
                        android:text="@string/rotulo_criado_em" />

                    <TextView
                        android:id="@+id/tvCriadoEm"
                        style="@style/Producao.Texto.Valor"
                        tools:text="18/11/2026 08:30" />

                    <LinearLayout
                        android:id="@+id/linhaAtualizadoEm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Producao.Texto.Rotulo"
                            android:layout_marginTop="@dimen/espaco_grande"
                            android:text="@string/rotulo_atualizado_em" />

                        <TextView
                            android:id="@+id/tvAtualizadoEm"
                            style="@style/Producao.Texto.Valor"
                            tools:text="18/11/2026 09:10" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Descrição ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Producao.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_tela">

                    <TextView
                        style="@style/Producao.Texto.Rotulo"
                        android:text="@string/rotulo_descricao" />

                    <TextView
                        android:id="@+id/tvDescricao"
                        style="@style/Producao.Texto.Valor"
                        android:lineSpacingMultiplier="1.2"
                        android:textIsSelectable="true"
                        tools:text="Setup do molde 115 iniciado às 07h40 e finalizado às 08h25." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlternarStatus"
                style="@style/Widget.Producao.Botao.Contorno"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/acao_marcar_concluido"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============ Rodapé fixo ============ -->
    <LinearLayout
        android:id="@+id/barraAcoes"
        style="@style/Producao.BarraRodape">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExcluir"
            style="@style/Widget.Producao.Botao.Contorno.Perigo"
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/espaco_pequeno"
            android:layout_weight="1"
            android:text="@string/acao_excluir"
            app:icon="@drawable/ic_delete" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditar"
            style="@style/Widget.Producao.Botao.Principal"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/espaco_pequeno"
            android:layout_weight="1"
            android:text="@string/acao_editar"
            app:icon="@drawable/ic_edit" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
