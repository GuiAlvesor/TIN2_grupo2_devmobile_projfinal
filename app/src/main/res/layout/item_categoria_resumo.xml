<?xml version="1.0" encoding="utf-8"?>
<!-- Card reutilizável (via <include>) com o atalho de uma categoria na tela inicial -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/espaco_grande"
    android:layout_marginTop="@dimen/espaco_pequeno"
    android:layout_marginEnd="@dimen/espaco_grande"
    android:layout_marginBottom="@dimen/espaco_pequeno"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/altura_toque_minima"
        android:orientation="horizontal"
        android:padding="@dimen/espaco_grande">

        <ImageView
            android:id="@+id/ivIconeCategoria"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circulo"
            android:contentDescription="@null"
            android:padding="12dp"
            tools:src="@drawable/ic_registro" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_grande"
            android:layout_marginEnd="@dimen/espaco_medio"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="Registros" />

            <TextView
                android:id="@+id/tvDescricaoCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Ocorrências e apontamentos" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQuantidadeCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold"
            tools:text="3" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
