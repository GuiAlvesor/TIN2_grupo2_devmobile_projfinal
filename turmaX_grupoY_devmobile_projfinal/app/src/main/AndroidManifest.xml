<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml - declara todas as Activities do aplicativo.

    - O aplicativo funciona 100% offline: nenhuma permissão de rede (INTERNET)
      é declarada, pois todos os dados ficam em memória no próprio dispositivo.
    - Somente a MainActivity possui intent-filter (MAIN / LAUNCHER) e exported="true",
      pois é o ponto de entrada aberto pelo launcher do Android.
    - As demais telas são abertas apenas por Intents EXPLÍCITAS dentro do próprio app
      (ex.: new Intent(this, ListaRegistrosActivity.class)), por isso exported="false".
    - parentActivityName define a hierarquia de navegação ("voltar para cima").
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RegistroProducao"
        tools:targetApi="31">

        <!-- Activity principal: painel inicial e ponto de entrada do aplicativo -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity de listagem (READ): busca, filtro e exclusão por gesto -->
        <activity
            android:name=".ListaRegistrosActivity"
            android:exported="false"
            android:label="@string/titulo_lista"
            android:parentActivityName=".MainActivity" />

        <!-- Activity de cadastro com CRUD completo (CREATE / READ / UPDATE / DELETE).
             adjustResize mantém os campos visíveis quando o teclado abre. -->
        <activity
            android:name=".FormularioRegistroActivity"
            android:exported="false"
            android:label="@string/titulo_novo"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Activity de detalhes: visualizar, alterar status, editar e excluir -->
        <activity
            android:name=".DetalheRegistroActivity"
            android:exported="false"
            android:label="@string/titulo_detalhe"
            android:parentActivityName=".ListaRegistrosActivity" />
    </application>

</manifest>
